# Bezpieczeństwo: paczki npm nie uruchamiają własnych skryptów przy instalacji (preinstall/postinstall – tą drogą
# zainfekowane paczki wykonują kod na komputerze). Żadna z naszych zależności ich nie potrzebuje (esbuild działa bez nich).
ignore-scripts=true
# Instalacja tylko z oficjalnego rejestru, dokładnie wersje z package-lock.json (npm ci)
registry=https://registry.npmjs.org/
audit-level=high
